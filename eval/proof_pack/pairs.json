    {
      "id": "not_in_null_in_list",
      "title": "NOT IN to NOT EXISTS: a NULL arrives in the list",
      "baseline_sql": "SELECT c.CustomerID FROM pp.Customers AS c WHERE c.Email NOT IN (SELECT s.Email FROM pp.Suppressions AS s)",
      "rewrite_sql": "SELECT c.CustomerID FROM pp.Customers AS c WHERE NOT EXISTS (SELECT 1 FROM pp.Suppressions AS s WHERE s.Email = c.Email)",
      "parameters": {},
      "parameter_types": {},
      "reason": "x NOT IN (list) is never true when the list holds a NULL, so the baseline returns no rows. NOT EXISTS ignores the NULL.",
      "tells_apart": "One row in Suppressions with Email NULL.",
      "would_be_equivalent_if": [
        {
          "kind": "not_null",
          "table": "pp.Suppressions",
          "columns": [
            "Email"
          ]
        },
        {
          "kind": "not_null",
          "table": "pp.Customers",
          "columns": [
            "Email"
          ]
        }
      ],
      "equal_on": {
        "pp.Customers": [
          [
            1,
            "a@x.test",
            "S",
            null
          ],
          [
            2,
            "b@x.test",
            "S",
            null
          ],
          [
            3,
            "c@x.test",
            "G",
            null
          ]
        ],
        "pp.Suppressions": [
          [
            1,
