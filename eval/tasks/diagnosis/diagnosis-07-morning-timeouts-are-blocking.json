  "key": {
    "root_cause": "lock_escalation_blocking",
    "required_facts": [
      {
        "id": "table_lock_held_by_the_batch",
        "evidence": "locks",
        "description": "Session 412, batch step 4, holds an exclusive lock on the whole dbo.Inventory table.",
        "signals": {
          "all": [
            "\\b412\\b|step 4",
            "object|table",
            "\\bX\\b|exclusive"
          ]
        },
        "example": "Session 412 (batch step 4) holds an OBJECT X lock on dbo.Inventory."
      },
      {
        "id": "order_sessions_wait_on_it",
        "evidence": "sessions",
        "description": "77 order sessions wait behind it, for up to 29.4 s.",
        "signals": {
          "all": [
            "\\b77\\b",
            "29[.,]4|29,?410|\\b412\\b"
          ]
        },
        "example": "77 usp_CreateOrder sessions are blocked by session 412, waiting up to 29,410 ms."
      },
      {
        "id": "cpu_is_not_the_limit",
        "evidence": "wed_night",
        "description": "CPU is not saturated in that window.",
        "signals": {
          "all": [
            "\\bcpu\\b",
            "\\b(4[3-9]|5[01])\\s?%|not (saturated|the limit|cpu[- ]bound)|\\b0 minutes\\b"
          ]
        },
        "example": "CPU is 43 to 46% between 07:45 and 08:45 on Wed 23, while the timeouts happen."
      }
    ],
    "harmful_conclusions": [
      {
        "id": "longer_timeout",
        "description": "A longer timeout makes callers wait longer behind the same lock.",
        "signals": {
          "any": [
            "(increase|raise|extend|lengthen)\\b[^.]*timeout",
            "\\b(longer|higher|larger)\\s+(command\\s?)?timeout"
          ]
        },
        "example": "Increase CommandTimeout to 120 seconds."
      },
      {
        "id": "dirty_reads",
        "description": "The blocked statements are writes. NOLOCK does not apply to them and would corrupt stock figures if it did.",
        "signals": {
          "any": [
            "\\bnolock\\b",
            "read\\s?uncommitted"
          ]
        },
        "example": "Add WITH (NOLOCK) to the inventory statements."
      },
      {
        "id": "kill_the_batch_session",
        "description": "Killing a 36-minute update starts a rollback of about the same length, still under the lock.",
        "signals": {
          "any": [
            "\\bkill\\b"
          ]
        },
        "example": "Kill session 412 when blocking starts."
      },
      {
        "id": "cpu_as_the_cause",
        "description": "CPU is at 43 to 46% in the morning window.",
        "root_causes": [
          "cpu_capacity",
          "worker_exhaustion"
        ]
      }
    ]
  }
