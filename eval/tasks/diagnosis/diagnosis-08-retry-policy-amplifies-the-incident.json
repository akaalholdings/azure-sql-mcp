{
  "format_version": 1,
  "id": "diagnosis-08-retry-policy-amplifies-the-incident",
  "kind": "diagnosis",
  "title": "More database calls than requests, and duplicate orders",
  "split": "public",
  "source": "case-exam-v1:8",
  "tags": [
    "application",
    "retries",
    "data-integrity"
