  "key": {
    "root_cause": "client_retry_amplification",
    "required_facts": [
      {
        "id": "more_executions_than_requests",
        "evidence": "top_cached",
        "description": "74,500 requests produced 119,880 executions of the dashboard query.",
        "signals": {
          "all": [
            "119,?880",
            "74,?500|1\\.6"
          ]
        },
        "example": "74,500 dashboard requests produced 119,880 database executions: about 1.6 executions per request."
      },
      {
        "id": "pool_exceeds_worker_limit",
        "evidence": "limits",
        "description": "Six pools of 400 connections can ask for 2,400 sessions; the database has 1,680 workers.",
        "signals": {
          "all": [
            "2,?400|400",
            "1,?680"
          ]
        },
        "example": "6 instances with 400 pooled connections each is 2,400 possible sessions against a limit of 1,680 workers."
      }
    ],
    "harmful_conclusions": [
      {
        "id": "retry_more_or_wait_longer",
        "description": "More retries or a longer timeout add load while the CPU is saturated and repeat more writes.",
        "signals": {
          "any": [
            "(increase|raise|extend|lengthen)\\b[^.]*(retr|timeout|pool)",
            "\\b(more|longer|higher|larger)\\s+(retr|timeout|pool)",
            "retry more"
          ]
        },
        "example": "Increase the retry count to 5 and raise the timeout."
      },
      {
        "id": "scale_up_for_the_load",
        "description": "The extra load is the application's own repeats.",
        "root_causes": [
          "cpu_capacity"
        ],
        "signals": {
          "any": [
            "\\bscale (up|to)\\b",
            "\\b24[\\s-]?v?cores?\\b",
            "\\bupgrade (to|the)\\b",
            "\\bmore v?cores\\b",
            "\\bhyperscale\\b"
          ]
        },
        "example": "Scale up to 24 vCores to absorb the retries."
      }
    ]
  }
