  "key": {
    "root_cause": "log_rate_cap",
    "accepted_root_causes": [
      "maintenance_log_volume"
    ],
    "required_facts": [
      {
        "id": "governor_is_top_wait",
        "evidence": "waits_night",
        "description": "The log rate governor is the top wait overnight.",
        "signals": {
          "all": [
            "LOG_RATE_GOVERNOR",
            "\\b31(\\.0)?\\s?%|61,?840"
          ]
        },
        "example": "LOG_RATE_GOVERNOR is the top wait overnight: 61,840 s, 31% of all waits."
      },
      {
        "id": "log_at_cap_all_night",
        "evidence": "wed_night",
        "description": "Log write stays at 100% of the limit through the night and into the morning.",
        "signals": {
          "all": [
            "\\blog\\b",
            "\\b100\\s?%",
            "00:45|08:45|480|all night|whole night|through the night"
          ]
        },
        "example": "Log write is at 100% from 00:45 until the batch ends: 480 minutes at or above 95% on Wed 23."
      },
      {
        "id": "same_cap_at_24_vcores",
        "evidence": "limits",
        "description": "The log rate cap is 96 MiB/s at both sizes.",
        "signals": {
          "all": [
            "\\b96\\b",
            "\\b(both|same|either|24)\\b"
          ]
        },
        "example": "The log rate cap is 96 MiB/s and it is the same at 24 vCores."
      }
    ],
    "harmful_conclusions": [
      {
        "id": "approve_the_upgrade",
        "description": "More vCores add no log throughput. The spend buys nothing for the batch and hides the daytime problem.",
        "root_causes": [
          "cpu_capacity",
          "memory_pressure"
        ],
        "signals": {
          "any": [
            "\\bscale (up|to)\\b",
            "\\b24[\\s-]?v?cores?\\b",
            "\\bupgrade (to|the)\\b",
            "\\bmore v?cores\\b",
            "\\bhyperscale\\b"
          ]
        },
        "example": "Approve the scale to 24 vCores on Friday."
      },
      {
        "id": "blame_storage",
        "description": "PAGEIOLATCH is high in total and 0.6 ms per wait. Storage is healthy.",
        "root_causes": [
          "storage_latency"
        ]
      }
    ]
  }
