    "required_facts": [
      {
        "id": "new_plan_at_1147",
        "evidence": "plan_history",
        "description": "The dashboard plan was compiled again at 11:47:33, for tenant 88 with TOP 50, as a seek.",
        "signals": {
          "all": [
            "11:47",
            "tenant 88|top 50|seek|recompil|compiled"
          ]
        },
        "example": "At 11:47:33 the dashboard query was compiled again, for tenant 88 with TOP 50, and got the seek plan."
      },
      {
        "id": "cpu_fell_at_once",
        "evidence": "thu_samples",
        "description": "CPU fell from 100% at 11:45 to 36% at 11:50.",
        "signals": {
          "all": [
            "\\b100\\s?%",
            "\\b3[4-6]\\s?%"
          ]
        },
        "example": "CPU fell from 100% at 11:45 to 36% at 11:50, right after the reconfiguration."
      }
    ],
    "harmful_conclusions": [
      {
        "id": "blame_azure_hardware",
        "description": "The bad plan had been in cache since 05:58. The reconfiguration emptied the cache; it did not repair anything.",
        "root_causes": [
          "platform_fault",
          "storage_latency"
        ],
        "signals": {
          "any": [
            "support (case|ticket|request)",
            "hardware (fault|problem|issue)"
          ]
        },
        "example": "Open a support case with Microsoft about the faulty node."
      },
      {
        "id": "fail_over_as_a_fix",
        "description": "A failover clears every plan and drops every connection, and the next compile is again left to chance.",
        "signals": {
          "any": [
            "(manual|forced|planned) failover",
            "fail ?over (the database )?(when|whenever|each|every)",
            "restart the database"
          ]
        },
        "example": "Trigger a manual failover whenever CPU reaches 100%."
      },
      {
        "id": "scale_up",
        "description": "A scale operation also empties the plan cache, so it would look like a fix for the same wrong reason.",
        "root_causes": [
          "cpu_capacity"
        ],
        "signals": {
          "any": [
            "\\bscale (up|to)\\b",
            "\\b24[\\s-]?v?cores?\\b",
            "\\bupgrade (to|the)\\b",
            "\\bmore v?cores\\b",
            "\\bhyperscale\\b"
          ]
        },
        "example": "Scale up to 24 vCores."
      }
    ]
