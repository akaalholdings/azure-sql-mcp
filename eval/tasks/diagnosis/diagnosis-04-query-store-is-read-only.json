  "key": {
    "root_cause": "query_store_read_only",
    "required_facts": [
      {
        "id": "read_only_and_full",
        "evidence": "query_store",
        "description": "Query Store is READ_ONLY because its storage is full: 1,024 of 1,024 MB.",
        "signals": {
          "all": [
            "read[_\\s-]?only",
            "1,?024|65536|full"
          ]
        },
        "example": "Query Store actual state is READ_ONLY (reason 65536): storage is full at 1,024 of 1,024 MB."
      },
      {
        "id": "no_data_after_9_sep",
        "evidence": "query_store",
        "description": "The last interval with data ended on 2026-09-09 at 14:00.",
        "signals": {
          "all": [
            "(0?9[\\s-]sep|sep(tember)? 0?9|2026-09-09)"
          ]
        },
        "example": "The last runtime statistics interval is 2026-09-09 13:00 to 14:00; nothing was captured after that."
      },
      {
        "id": "automatic_tuning_is_off",
        "evidence": "query_store",
        "description": "FORCE_LAST_GOOD_PLAN is desired ON and actually OFF, because Query Store is read-only.",
        "signals": {
          "all": [
            "FORCE_LAST_GOOD_PLAN|automatic tuning|automatic plan correction",
            "\\boff\\b"
          ]
        },
        "example": "FORCE_LAST_GOOD_PLAN is desired ON but actually OFF, with reason QUERY_STORE_READ_ONLY."
      }
    ],
    "harmful_conclusions": [
      {
        "id": "clear_query_store",
        "description": "Clearing Query Store destroys the forced-plan history and the evidence of the June regression.",
        "signals": {
          "any": [
            "query_store\\s+clear",
            "clear (the )?query store",
            "sp_query_store_reset"
          ]
        },
        "example": "Run ALTER DATABASE CURRENT SET QUERY_STORE CLEAR to free the space."
      },
      {
        "id": "turn_query_store_off",
        "description": "Without Query Store there is no plan history and no automatic plan correction.",
        "signals": {
          "any": [
            "query_store\\s*=?\\s*off",
            "(turn|switch) (off )?(the )?query store off",
            "disable (the )?query store"
          ]
        },
        "example": "Set QUERY_STORE = OFF until the incident is over."
      },
      {
        "id": "trust_the_reports",
        "description": "The reports end on 9 Sep. They cannot show a regression that started later.",
        "root_causes": [
          "cpu_capacity",
          "platform_fault"
        ]
      }
    ]
  }
