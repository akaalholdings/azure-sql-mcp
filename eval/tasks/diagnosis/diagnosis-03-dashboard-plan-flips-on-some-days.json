  "key": {
    "root_cause": "parameter_sensitive_plan",
    "required_facts": [
      {
        "id": "compiled_for_the_report",
        "evidence": "plan_history",
        "description": "On each bad day the plan was compiled with tenant 1, a 365-day range and TOP 100000.",
        "signals": {
          "all": [
            "tenant 1\\b",
            "100,?000|365"
          ]
        },
        "example": "On Tue, Thu and Fri the plan was compiled for tenant 1 with TOP 100000 and a 365-day range."
      },
      {
        "id": "cost_per_call",
        "evidence": "top_cached",
        "description": "The dashboard query costs 2,261 ms of CPU per call on a bad day against 3.4 ms on a good day.",
        "signals": {
          "all": [
            "2,?261|271,?000",
            "3\\.4|\\b410\\b"
          ]
        },
        "example": "The dashboard query averages 2,261 ms of CPU per call on Fri 25 against 3.4 ms on Mon 21."
      },
      {
        "id": "compile_follows_the_statistics_update",
        "evidence": "plan_history",
        "description": "The bad plan is compiled seconds after the index job updates the Orders statistics, while TenantReport runs.",
        "signals": {
          "all": [
            "statistic",
            "06:02|06:10|05:58|index job|seconds after|right after"
          ]
        },
        "example": "Each bad plan is compiled seconds after the index job updates the Orders statistics, for example 06:02:09 then 06:02:17 on Fri 25."
      }
    ],
    "harmful_conclusions": [
      {
        "id": "scale_up_for_cpu",
        "description": "One plan uses 271,000 of the 316,800 CPU-seconds in the window. More vCores hide that plan at a permanent cost.",
        "root_causes": [
          "cpu_capacity"
        ],
        "signals": {
          "any": [
            "\\bscale (up|to)\\b",
            "\\b24[\\s-]?v?cores?\\b",
            "\\bupgrade (to|the)\\b",
            "\\bmore v?cores\\b",
            "\\bhyperscale\\b"
          ]
        },
        "example": "Scale up to 24 vCores to get CPU headroom."
      },
      {
        "id": "maxdop_one",
        "description": "CXPACKET is a symptom of the bad parallel plan. MAXDOP 1 slows the batch and leaves a serial scan of 1.4M pages per call.",
        "root_causes": [
          "parallelism_misconfiguration"
        ],
        "signals": {
          "any": [
            "maxdop\\s*(=|to|of)?\\s*1\\b"
          ]
        },
        "example": "Set MAXDOP to 1 for the database."
      },
      {
        "id": "blame_the_platform",
        "description": "The bad days follow the timing of the client's own job, not an Azure event.",
        "root_causes": [
          "platform_fault",
          "storage_latency"
        ]
      },
      {
        "id": "scheduled_cache_flush",
        "description": "A scheduled plan cache flush recompiles every query and leaves the next compile to chance.",
        "signals": {
          "all": [
            "(daily|nightly|every (day|morning|night)|schedul)"
          ],
          "any": [
            "freeproccache",
            "clear procedure_cache",
            "flush the plan cache"
          ]
        },
        "example": "Schedule a daily DBCC FREEPROCCACHE at 07:00."
      }
    ]
  }
