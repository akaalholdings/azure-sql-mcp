{
  "format_version": 1,
  "id": "diagnosis-03-dashboard-plan-flips-on-some-days",
  "kind": "diagnosis",
  "title": "Random bad days: CPU at 100% on Tuesday, Thursday and Friday",
  "split": "public",
  "source": "case-exam-v1:3",
