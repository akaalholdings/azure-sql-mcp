  "key": {
    "root_cause": "maintenance_log_volume",
    "required_facts": [
      {
        "id": "index_job_writes_most_of_the_log",
        "evidence": "log_bytes",
        "description": "The index job wrote 1.94 TB of the 2.71 TB of log on Wed 23.",
        "signals": {
          "all": [
            "1\\.94",
            "2\\.71|\\bTB\\b"
          ]
        },
        "example": "Index maintenance wrote 1.94 TB of the 2.71 TB of log on Wed 23; the batch wrote 0.71 TB."
      },
      {
        "id": "volume_grew_after_the_job_change",
        "evidence": "log_bytes",
        "description": "Log volume was 1.09 TB on a night in August, before the job change.",
        "signals": {
          "all": [
            "1\\.09|0\\.71",
            "aug|before|was\\b"
          ]
        },
        "example": "On 24 Aug, before the job change, the night wrote 1.09 TB of log in total and index maintenance 0.71 TB."
      },
      {
        "id": "log_at_cap_while_both_run",
        "evidence": "wed_night",
        "description": "Log write is at 100% while the rebuild and the batch run together.",
        "signals": {
          "all": [
            "\\blog\\b",
            "\\b100\\s?%",
            "rebuild|index job|maintenance"
          ]
        },
        "example": "Log write is at 100% of the limit from 00:45, while the rebuild and the batch run together."
      }
    ],
    "harmful_conclusions": [
      {
        "id": "reorganize_as_the_light_option",
        "description": "REORGANIZE is fully logged and often writes more log than a rebuild.",
        "signals": {
          "any": [
            "reorgani[sz]e"
          ]
        },
        "example": "Switch the job from REBUILD to REORGANIZE to cut the log."
      },
      {
        "id": "change_the_recovery_model",
        "description": "Azure SQL Database always runs in FULL recovery; there is no minimal logging to switch on.",
        "signals": {
          "any": [
            "recovery model",
            "\\bsimple recovery\\b",
            "bulk[\\s_-]?logged",
            "minimal(ly)? logg"
          ]
        },
        "example": "Set the recovery model to SIMPLE during the maintenance window."
      },
      {
        "id": "scale_up_for_the_log",
        "description": "The log rate cap is 96 MiB/s at 16 and at 24 vCores.",
        "root_causes": [
          "cpu_capacity",
          "storage_latency"
        ],
        "signals": {
          "any": [
            "\\bscale (up|to)\\b",
            "\\b24[\\s-]?v?cores?\\b",
            "\\bupgrade (to|the)\\b",
            "\\bmore v?cores\\b",
            "\\bhyperscale\\b"
          ]
        },
        "example": "Scale up to 24 vCores to get more log throughput."
      }
    ]
  }
