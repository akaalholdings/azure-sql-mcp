  "key": {
    "root_cause": "scan_volume_not_storage_latency",
    "required_facts": [
      {
        "id": "each_read_is_fast",
        "evidence": "waits_night",
        "description": "PAGEIOLATCH_SH averages 0.6 ms per wait.",
        "signals": {
          "all": [
            "PAGEIOLATCH",
            "0\\.[4-8]\\s?ms"
          ]
        },
        "example": "PAGEIOLATCH_SH is 38,950 s in total but 0.6 ms per wait: each read is fast."
      },
      {
        "id": "data_io_below_the_limit",
        "evidence": "wed_night",
        "description": "Data IO peaks at 66% of the limit.",
        "signals": {
          "all": [
            "data[\\s_]?io",
            "\\b(6[1-6]|58)\\s?%|below|under"
          ]
        },
        "example": "Data IO peaks at 66% of the limit overnight, below its cap."
      }
    ],
    "harmful_conclusions": [
      {
        "id": "maxdop_one",
        "description": "The parallel waits come from the rebuilds and from one bad parallel plan. MAXDOP 1 makes the batch and the rebuilds slower and fixes neither.",
        "root_causes": [
          "parallelism_misconfiguration"
        ],
        "signals": {
          "any": [
            "maxdop\\s*(=|to|of)?\\s*1\\b"
          ]
        },
        "example": "Set MAXDOP to 1."
      },
      {
        "id": "buy_faster_storage",
        "description": "Business Critical local storage answers in under a millisecond here. More IOPS or another tier changes nothing.",
        "root_causes": [
          "storage_latency"
        ],
        "signals": {
          "any": [
            "\\biops\\b",
            "faster storage",
            "storage tier",
            "\\bhyperscale\\b"
          ]
        },
        "example": "Move to a tier with more IOPS."
      }
    ]
  }
